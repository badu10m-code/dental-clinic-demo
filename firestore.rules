rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == "sudipta2santra@gmail.com" && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Admins Collection
    match /admins/{adminId} {
      allow get: if isVerifiedAdmin() || (isSignedIn() && request.auth.uid == adminId);
      allow list: if isVerifiedAdmin();
      allow create, update: if isVerifiedAdmin();
      allow delete: if isVerifiedAdmin();
    }

    // Appointments Collection
    match /appointments/{appointmentId} {
      allow create: if isValidId(appointmentId) && incoming().status == 'new';
      allow get: if isVerifiedAdmin() || (resource != null && resource.data.ref == appointmentId);
      allow list: if isVerifiedAdmin();
      allow update: if isVerifiedAdmin();
      allow delete: if isVerifiedAdmin();
    }

    // Patients Ledger
    match /patients/{patientId} {
      allow read, write: if isVerifiedAdmin();
    }

    // In-depth Blog Articles & Clinical Guides
    match /articles/{articleSlug} {
      allow read: if true;
      allow create, update, delete: if isVerifiedAdmin();
    }

    // Blog / Clinic Updates
    match /posts/{postId} {
      allow read: if true;
      allow create, update, delete: if isVerifiedAdmin();
    }

    // Promotional & Festival Banners
    match /banners/{bannerId} {
      allow read: if true;
      allow create, update, delete: if isVerifiedAdmin();
    }

    // Clinic Settings & Contact Hours
    match /settings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isVerifiedAdmin();
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
